# pnpm writes LF and rewrites this file on every install. Pinning it keeps the
# blob stable instead of flip-flopping with whoever ran install last.
pnpm-lock.yaml text eol=lf

# Generated by packages/database/src/packSchemas.ts (schemas:generate); must
# stay byte-identical to what serialiseSchema() emits (LF), regardless of a
# contributor's core.autocrlf setting, or the no-diff check in
# packSchemas.test.ts spuriously fails on a fresh Windows clone even though
# the content has not drifted.
packages/database/data/schemas/*.schema.json text eol=lf
