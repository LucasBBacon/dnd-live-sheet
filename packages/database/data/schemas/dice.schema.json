{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "dice.schema.json",
    "title": "Dice Rule",
    "type": "object",
    "definitions": {
        "RNGMutator": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "reroll_once",
                        "minimum_value",
                        "explode"
                    ]
                },
                "triggerOn": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "floorValue": {
                    "type": "number"
                }
            }
        },
        "criticalHitModifiers": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "add_base_die",
                        "add_specific_die",
                        "maximize_dice"
                    ]
                },
                "diceToAdd": {
                    "type": "string"
                },
                "damageType": {
                    "$ref": "./affinities.schema.json#/definitions/damageType"
                },
                "requiredAttackTypes": {
                    "type": "array",
                    "items": {
                        "$ref": "./actions.schema.json#/definitions/attackType"
                    },
                    "default": []
                },
                "requiredStates": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": []
                },
                "forbiddenStates": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": []
                }
            }
        }
    },
    "properties": {
        "target": {
            "type": "string",
            "enum": [
                "DAMAGE_ROLL",
                "ATTACK_ROLL",
                "SAVING_THROW",
                "ABILITY_CHECK"
            ]
        },
        "requiredStates": {
            "type": "array",
            "items": {
                "type": "array",
                "items": {
                    "type": "string"
                },
                "default": []
            }
        },
        "requiredDamageType": {
            "$ref": "./affinities.schema.json#/definitions/damageType"
        },
        "mutator": {
            "$ref": "#/definitions/RNGMutator"
        }
    },
    "required": [
        "target",
        "mutator"
    ]
}