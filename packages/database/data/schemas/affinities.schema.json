{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "affinities.schema.json",
    "title": "Affinities Block",
    "type": "object",
    "definitions": {
        "damageType": {
            "type": "string",
            "enum": [
                "acid",
                "bludgeoning",
                "cold",
                "fire",
                "force",
                "lightning",
                "necrotic",
                "piercing",
                "poison",
                "psychic",
                "radiant",
                "slashing",
                "thunder",
                "same_as_weapon"
            ]
        },
        "affinityLevel": {
            "type": "string",
            "enum": [
                "vulnerability",
                "resistance",
                "immunity"
            ]
        },
        "damageBypass": {
            "type": "string",
            "enum": [
                "magical",
                "silvered",
                "adamantine",
                "spell"
            ]
        },
        "fixedAffinityGrant": {
            "type": "object",
            "properties": {
                "damageType": {
                    "$ref": "#/definitions/damageType"
                },
                "level": {
                    "$ref": "#/definitions/affinityLevel",
                    "default": "resistance"
                },
                "bypassedBy": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/damageBypass"
                    },
                    "default": []
                },
                "requiredStates": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": []
                }
            },
            "required": [
                "damageType"
            ]
        },
        "choiceAffinityGrant": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "chooseAmount": {
                    "type": "number",
                    "minimum": 1,
                    "default": 1
                },
                "options": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/damageType"
                    }
                },
                "level": {
                    "$ref": "#/definitions/affinityLevel",
                    "default": "resistance"
                },
                "bypassedBy": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/damageBypass"
                    },
                    "default": []
                },
                "requiredStates": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": []
                }
            }
        }
    },
    "properties": {
        "fixed": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/fixedAffinityGrant"
            },
            "default": []
        },
        "choices": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/choiceAffinityGrant"
            },
            "default": []
        }
    }
}