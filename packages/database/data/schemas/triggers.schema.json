{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "triggers.schema.json",
    "title": "Trigger Grant",
    "type": "object",
    "definitions": {
        "engineEvent": {
            "type": "string",
            "enum": [
                "ON_HP_REDUCED_TO_ZERO",
                "ON_ATTACK_HIT",
                "ON_SAVING_THROW_FAILED",
                "ON_START_OF_TURN",
                "ON_END_OF_TURN",
                "ON_SHORT_REST",
                "ON_LONG_REST"
            ]
        }
    },
    "properties": {
        "listenFor": {
            "$ref": "#/definitions/engineEvent"
        },
        "executeAction": {
            "type": "string"
        },
        "consumeResource": {
            "type": "string"
        }
    }
}