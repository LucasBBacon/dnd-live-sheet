{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "weapons.schema.json",
    "title": "Weapon Definition",
    "type": "object",
    "definitions": {
        "weaponCategory": {
            "type": "string",
            "enum": [
                "simple_melee",
                "martial_melee",
                "simple_ranged",
                "martial_ranged"
            ]
        },
        "weaponProperty": {
            "type": "string",
            "enum": [
                "finesse",
                "thrown",
                "heavy",
                "light",
                "two_handed",
                "versatile",
                "reach",
                "ammunition",
                "loading",
                "special",
                "range"
            ]
        }
    },
    "required": [
        "id",
        "name",
        "category",
        "damageDice",
        "damageType",
        "properties",
        "range"
    ],
    "properties": {
        "id": {
            "$ref": "./common.schema.json#/definitions/coreRuleId"
        },
        "name": {
            "type": "string"
        },
        "category": {
            "$ref": "#/definitions/weaponCategory"
        },
        "damageDice": {
            "type": "string"
        },
        "versatileDamageDice": {
            "type": "string"
        },
        "damageType": {
            "$ref": "./affinities.schema.json#/definitions/damageType"
        },
        "properties": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/weaponProperty"
            }
        },
        "range": {
            "type": "number",
            "default": 5
        },
        "longRange": {
            "type": "number"
        },
        "ammoItemId": {
            "type": "string"
        },
        "ammoTag": {
            "type": "string"
        }
    }
}