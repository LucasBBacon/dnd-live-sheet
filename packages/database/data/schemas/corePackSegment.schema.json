{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "corePackSegment.schema.json",
    "title": "Core Pack Segment",
    "type": "object",
    "properties": {
        "traits": {
            "type": "array",
            "items": {
                "$ref": "./traits.schema.json"
            }
        },
        "races": {
            "type": "array",
