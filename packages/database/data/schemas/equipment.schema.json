{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "equipments.schema.json",
    "title": "Equipment Definition",
    "type": "object",
    "definitions": {
        "containerCapacity": {
            "type": "object",
            "properties": {
                "capacityPounds": {
                    "type": "number"
                }
            }
        },
        "weaponCapability": {
            "type": "object",
            "properties": {
                "category": {
                    "$ref": "./weapons.schema.json#/definitions/weaponCategory"
                },
                "damageDice": {
                    "type": "string"
                }
            }
        }
    },
    "properties": {
        "id": {
            "$ref": "./common.schema.json#/definitions/coreRuleId"
        },
        "name": {
            "type": "string"
        },
        "type": {
            "$ref": "./common.schema.json#/definitions/equipmentType",
            "default": "gear"
        },
        "weight": {
            "type": "number",
            "default": 0
        },
        "armorCategory": {
            "$ref": "./common.schema.json#/definitions/armorCategory"
        },
        "equipSlot": {
            "$ref": "./common.schema.json#/definitions/equipSlot"
        },
        "requiresAttunement": {
            "type": "boolean",
            "default": false
        },
        "ammoTag": {
            "type": "string"
        },
        "container": {
            "$ref": "#/definitions/containerCapacity"
        },
        "categoryTags": {
            "type": "array",
            "items": {
                "$ref": "./common.schema.json#/definitions/startingEquipmentCategoryTag"
            }
        },
        "modifiers": {
            "type": "array",
            "items": {
                "$ref": "./modifiers.schema.json#/definitions/baseModifier"
            }
        },
        "weapon": {
            "$ref": "#/definitions/weaponCapability"
        }
    }
}