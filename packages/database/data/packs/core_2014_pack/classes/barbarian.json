        {
            "id": "trait_danger_sense",
            "name": "Danger Sense",
            "lore": {
                "shortDescription": "Advantage on Dexterity saving throws against effects you can see, unless you are blinded, deafened, or incapacitated.",
                "fullText": "At 2nd level, you gain an uncanny sense of when things nearby aren't as they should be, giving you an edge when you dodge away from danger. You have advantage on Dexterity saving throws against effects that you can see, such as traps and spells. To gain this benefit, you can't be blinded, deafened, or incapacitated."
            },
            "isStartingProficiency": false,
            "implementation": {
                "mode": "engine",
                "summary": "The engine resolves what it can know: the advantage is withdrawn entirely while blinded, deafened, or incapacitated. Whether a given effect is one you can see is settled at the table, so that half is carried as an appliesWhen rider and surfaced beside the Dexterity save rather than folded into the roll state.",
                "blockedBy": [
                    "blinded",
                    "deafened",
                    "incapacitated"
                ]
            },
            "modifiers": {
                "fixed": [
                    {
                        "target": "DEX_SAVE",
                        "type": "advantage",
                        "value": 0,
                        "appliesWhen": "against effects that you can see, such as traps and spells",
                        "scalingFactor": "none",
                        "requiredStates": [],
                        "forbiddenStates": [
                            "blinded",
                            "deafened",
                            "incapacitated"
                        ]
                    }
                ],
                "choices": []
            },
