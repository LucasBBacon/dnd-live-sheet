        {
            "id": "trait_extra_attack",
            "name": "Extra Attack",
            "lore": {
                "shortDescription": "You attack twice, rather than once, whenever you take the Attack action on your turn.",
                "fullText": "Beginning at 5th level, you can attack twice, instead of once, whenever you take the Attack action on your turn."
            },
            "isStartingProficiency": false,
            "implementation": {
                "mode": "engine",
                "summary": "Raises the number of attacks one Attack action grants from one to two at barbarian level 5. Authored as a competing set_base candidate because Extra Attack does not stack across classes: a character with it from two classes attacks the higher of the two counts, not the sum. The sheet reports the count; it does not track how many attacks have been used, since there is no turn lifecycle to reset such a counter against.",
                "blockedBy": []
            },
            "modifiers": {
                "fixed": [
                    {
                        "target": "ATTACKS_PER_ACTION",
                        "type": "set_base",
                        "value": 2,
                        "scalingFactor": "class_level_thresholds",
                        "scalingClassId": "class_barbarian",
                        "scalingThresholds": [
                            {
                                "minimumLevel": 5,
                                "value": 2
                            }
                        ],
                        "requiredStates": [],
                        "forbiddenStates": []
                    }
                ],
                "choices": []
            },
            "resources": [],
            "triggers": [],
            "diceRules": [],
            "criticalHitModifiers": [],
            "actions": []
        },
        {
            "id": "trait_fast_movement",
            "name": "Fast Movement",
            "lore": {
                "shortDescription": "Your speed increases by 10 feet while you aren't wearing heavy armour.",
                "fullText": "Starting at 5th level, your speed increases by 10 feet while you aren't wearing heavy armor."
            },
            "isStartingProficiency": false,
            "implementation": {
                "mode": "engine",
                "summary": "A flat SPEED bonus gated on the armour category of whatever occupies the body slot. The 5th-level gate is the progression grant rather than a scaling threshold, matching Danger Sense: a Barbarian 4 / Fighter 4 never receives the trait, so a threshold would restate what the grant already settles.",
                "blockedBy": [
                    "status_wearing_heavy_armor"
                ]
            },
            "modifiers": {
                "fixed": [
                    {
                        "target": "SPEED",
                        "type": "add",
                        "value": 10,
                        "scalingFactor": "none",
                        "requiredStates": [],
                        "forbiddenStates": [
                            "status_wearing_heavy_armor"
                        ]
                    }
                ],
                "choices": []
            },
            "resources": [],
            "triggers": [],
            "diceRules": [],
            "criticalHitModifiers": [],
            "actions": []
        },
        {
            "id": "trait_feral_instinct",
            "name": "Feral Instinct",
            "lore": {
                "shortDescription": "Advantage on initiative rolls. If you are surprised and not incapacitated, you can act normally on your first turn provided you rage before doing anything else.",
                "fullText": "By 7th level, your instincts are so honed that you have advantage on initiative rolls. Additionally, if you are surprised at the beginning of combat and aren't incapacitated, you can act normally on your first turn, but only if you enter your rage before doing anything else on that turn."
            },
            "isStartingProficiency": false,
            "implementation": {
                "mode": "engine",
                "summary": "The initiative advantage is a plain INITIATIVE advantage modifier, ungated: RAW attaches 'aren't incapacitated' to the surprise sentence only, so the initiative half applies unconditionally. The surprise clause is reported rather than enforced, matching the economy's track policy: the trait grants status_feral_instinct, and SurpriseEngine turns that plus the surprise flag and the raging state into a line on the sheet. 'Before doing anything else on that turn' is carried as guidance and deliberately not policed - the player is never blocked from acting first, so the ordering is unobservable. Movement, which surprise also forbids, is not tracked for anyone and stays the table's business.",
                "blockedBy": [
                    "incapacitated"
                ]
            },
            "grantedStates": [
                "status_feral_instinct"
            ],
            "modifiers": {
                "fixed": [
                    {
                        "target": "INITIATIVE",
                        "type": "advantage",
                        "value": 0,
                        "scalingFactor": "none",
                        "requiredStates": [],
                        "forbiddenStates": []
                    }
                ],
                "choices": []
            },
            "resources": [],
            "triggers": [],
            "diceRules": [],
            "criticalHitModifiers": [],
            "actions": []
        },
        {
            "id": "trait_brutal_critical",
            "name": "Brutal Critical",
            "lore": {
                "shortDescription": "Roll one additional weapon damage die on a critical hit with a melee attack, rising to two dice at 13th level and three at 17th.",
                "fullText": "Beginning at 9th level, you can roll one additional weapon damage die when determining the extra damage for a critical hit with a melee attack. This increases to two additional dice at 13th level and three additional dice at 17th level."
            },
            "isStartingProficiency": false,
            "implementation": {
                "mode": "engine",
                "summary": "One critical-hit modifier whose die count scales on class_level_thresholds, rather than three traits granted at 9, 13 and 17. The progression re-grants trait_brutal_critical at each threshold, which dedupes to a single instance - the same convention trait_rage uses while carrying its real progression in scalingThresholds. Stacks with Savage Attacks, which the engine gets for free by applying each matching modifier in turn.",
                "blockedBy": []
            },
            "modifiers": {
