        {
            "id": "trait_unarmored_defense_barbarian",
            "name": "Unarmored Defense (Barbarian)",
            "lore": {
                "shortDescription": "While you are not wearing armour, your AC is 10 + your Dexterity modifier + your Constitution modifier.",
                "fullText": "While you are not wearing armour, your AC is 10 + your Dexterity modifier + your Constitution modifier. This trait does not apply if you are wearing armour."
            },
            "isStartingProficiency": false,
            "implementation": {
